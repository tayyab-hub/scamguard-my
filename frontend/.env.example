# Public browser config. Never place secrets in VITE_* variables.
# Blank/unset resolves to same-origin /api/v1. Local Vite and production Vercel route that path
# through their existing proxies. Use an explicit non-local HTTPS URL only for a reviewed direct API.
VITE_API_BASE_URL=
# Optional public contact address used to prepare feedback in the user's email app.
# Leave blank to show the honest unavailable feedback state.
VITE_SUPPORT_EMAIL=
# Local or production proxy routing can explicitly use VITE_API_BASE_URL=/api/v1.
# Development proxy only; not used by the static preview or deployed frontend.
# Do not set this variable in Vercel or point a deployed browser at localhost.
API_PROXY_TARGET=http://127.0.0.1:8000
