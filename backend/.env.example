# Local API development only. Do not import backend variables into Vercel.
# The password below is a public example, not a real credential. Replace it for
# any non-disposable database and match the root Compose environment settings.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://scamguard:scamguard_local_only@127.0.0.1:5432/scamguard
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_SECONDS=3
# Enable only on a private development backend after applying migrations.
PERSISTENCE_ENABLED=false
PORT=8000
MAX_REQUEST_BYTES=65536
# Optional model overrides. Defaults use checksum-verified JSON artifacts bundled with the package.
# MESSAGE_MODEL_PATH=backend/app/ml/artifacts/message_tfidf_v1.json
# URL_MODEL_PATH=backend/app/url_intelligence/artifacts/url_model_v1.json
# Optional contextual review is backend-only, disabled by default and never required for local results.
AI_REVIEW_ENABLED=false
OPENAI_MODEL=gpt-5-mini-2025-08-07
AI_TIMEOUT_SECONDS=8
# Set OPENAI_API_KEY only in the backend process environment. Never commit it or expose it as VITE_*.
# OPENAI_API_KEY=
# Authentication uses an opaque HttpOnly cookie and server-side session records.
# Generate a unique value of at least 32 characters outside source control for non-local use.
AUTH_TOKEN_PEPPER=local-development-only-change-me
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
ANALYSIS_RATE_LIMIT=30
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
PASSWORD_RESET_CONFIRM_RATE_LIMIT=10
PASSWORD_RESET_TTL_MINUTES=30
# Local/test captures reset URLs in process memory. Production must use Resend.
FRONTEND_BASE_URL=http://localhost:5173
MAIL_PROVIDER=development
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SCAMGUARD <security@example.com>

# Production requires APP_ENV=production, PERSISTENCE_ENABLED=true, TLS DATABASE_URL,
# exact HTTPS CORS_ORIGINS, COOKIE_SECURE=true, COOKIE_SAMESITE=none and a strong pepper.
# Production also requires HTTPS FRONTEND_BASE_URL, MAIL_PROVIDER=resend, RESEND_API_KEY,
# and RESEND_FROM_EMAIL from a verified Resend sending domain.
# URL reputation is disabled: no live provider adapter or key is required.
